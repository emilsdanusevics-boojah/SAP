{
  "name": "sap-iee2e-exercise-tester",
  "version": "1.0.0",
  "description": "Walks through the SAP IEE2E course exercises (S/4HANA Cloud, Fiori) and reports pass/fail per step.",
  "main": "run.js",
  "scripts": {
    "test:all": "node run.js",
    "test:headed": "node run.js --headed --slowmo 250 --interactive --pause-on-fail",
    "validate": "node run.js --validate",
    "state": "node run.js --show-state",
    "selftest": "node test/selftest.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "playwright": "^1.51.0",
    "yaml": "^2.9.1"
  }
}

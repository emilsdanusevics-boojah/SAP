# Copy to .env and fill in. Never commit .env.
SAP_BASE_URL=https://my414802.s4hana.cloud.sap
SAP_USER=
SAP_PASSWORD=
# Your course number - the "###" in the exercises (e.g. 035).
# Leave empty to take the last three digits of SAP_USER (F000035 -> 035).
SAP_GROUP=
# Logon language: the task files use the English field labels.
SAP_LANGUAGE=EN
# Must match the date / decimal format in your SAP user settings (Settings > Language & Region).
SAP_DATE_FORMAT=DD.MM.YYYY
SAP_DECIMAL=,
# Default per-step timeout in milliseconds.
SAP_TIMEOUT=30000
# Exercise 18: the adapted course file F2121_###_PlanCostRate.xlsx
F2121_FILE=uploads/F2121_035_PlanCostRate.xlsx

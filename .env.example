# Copy to .env and fill in. Never commit .env.
SAP_BASE_URL=https://my414802.s4hana.cloud.sap
SAP_USER=
SAP_PASSWORD=
# Logon language: task files are written against English field labels.
SAP_LANGUAGE=EN
# Must match the date format in your SAP user settings (used by ${today} / ${date(+N)}).
SAP_DATE_FORMAT=MM/DD/YYYY
# Default per-step timeout in milliseconds.
SAP_TIMEOUT=30000
